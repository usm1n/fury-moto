# =============================================================================
# The Gear Doctor: environment variables
#
# Copy this file to `.env` for local work (`.env` is git-ignored; never commit it).
# The API does NOT read .env files by itself. Export the variables in your shell,
# or set them in the Vercel project (per environment) and as GitHub secrets.
#
# All values below are PLACEHOLDERS. Replace them. Do not reuse them anywhere.
# Legend:  [required] = the app or job fails without it   [optional] = has a default
# =============================================================================


# -----------------------------------------------------------------------------
# Database: Neon (Postgres 17)
# -----------------------------------------------------------------------------

# [required] Pooled connection string. Used by the running app (Vercel functions).
# Where: Neon console > project > Connect > tick "Pooled connection".
# Host contains "-pooler". Neon gives a URI; the app converts it to Npgsql format itself.
# Format: postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Local dev may use key=value instead, e.g. Host=localhost;Database=geardoctor;Username=geardoctor;Password=geardoctor_dev
NEON_DATABASE_URL=postgresql://neon_user:replace-me@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# [required for migrations and seeding] Direct (non-pooled) connection string.
# Where: same Neon "Connect" dialog, with "Pooled connection" UNticked.
# Host does NOT contain "-pooler". Used only by `dotnet ef` (migration bundle) and the
# seed job in CI. Migrations need session features the pooler does not provide.
# Format: same as above, without "-pooler" in the host.
NEON_DIRECT_URL=postgresql://neon_user:replace-me@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require


# -----------------------------------------------------------------------------
# Object storage: Cloudflare R2 (S3-compatible, product and category images)
# -----------------------------------------------------------------------------

# [required for uploads] Cloudflare account ID (32 hex characters).
# Where: Cloudflare dashboard > R2 > Overview (right-hand panel), or the account home page.
# Example format: 0123456789abcdef0123456789abcdef
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# [required for uploads] Access key ID of an R2 API token with Object Read & Write,
# scoped to the one bucket below. Shown ONCE when the token is created.
# Where: R2 > Manage API tokens > Create API token.
# Example format: 32 hex characters
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id

# [required for uploads] Secret access key of the same token. Shown once; store it in a password manager.
# Example format: 64 hex characters
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# [required for uploads] Bucket name, lowercase, no spaces.
# Example format: gear-doctor-media
R2_BUCKET=gear-doctor-media

# [required for uploads] Public base URL that serves the bucket (no trailing slash; the app trims one anyway).
# Production: your custom domain, e.g. https://images.example.com (see docs/DEPLOY.md).
# Dev only: the r2.dev URL (https://pub-<hash>.r2.dev). It is rate-limited by Cloudflare; do not use it in production.
R2_PUBLIC_BASE_URL=https://images.example.com

# [optional] Override the S3 endpoint for local S3-compatible testing (e.g. MinIO).
# Leave unset in every real environment.
# R2_SERVICE_URL=http://localhost:9000


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# [required in every environment except Development] Secret used to sign admin JWTs (HS256).
# Must be at least 32 bytes (UTF-8). Generate a fresh one per environment:
#   openssl rand -base64 48
# Example format (not a real key): replace-with-output-of-openssl-rand-base64-48
# Rotating it logs every admin out. Never put it in source control or a shared chat.
JWT_SIGNING_KEY=replace-with-output-of-openssl-rand-base64-48


# -----------------------------------------------------------------------------
# Bot protection: Cloudflare Turnstile (order form, contact form)
# -----------------------------------------------------------------------------

# [required in production] Turnstile secret key, server-side only.
# Where: Cloudflare dashboard > Turnstile > your widget > Settings > Secret key.
# Outside Development the API refuses to start without it (no silent always-pass fallback).
# Local Development uses Cloudflare's always-pass test secret when unset.
TURNSTILE_SECRET=replace-with-turnstile-secret-key

# [required] Turnstile site key, public. The API hands it to the storefront and admin.
# Where: same Turnstile widget, "Site key". Create one widget per hostname
# (production domain and, if you want it, the preview domain).
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key


# -----------------------------------------------------------------------------
# First admin account (seed job only)
# -----------------------------------------------------------------------------

# [required for the first seed] Email address of the first admin. Used as the login name.
# The seed creates this admin only if no admin exists yet. Later changes here are ignored.
ADMIN_EMAIL=owner@example.com

# [required for the first seed] Initial admin password. Used once.
# Rules: at least 12 characters, with at least one uppercase letter, one lowercase letter and one digit.
# The account is flagged MustChangePassword, so the owner must choose a new password on first login.
# Keep this out of shared notes; store it as a GitHub secret (ADMIN_INITIAL_PASSWORD).
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPw1


# -----------------------------------------------------------------------------
# SEO pre-render (product pages and sitemap served by the API)
# -----------------------------------------------------------------------------

# [required for /api/seo/*] Public origin of the storefront, no trailing slash. Used for canonical URLs,
# og:url, absolute image URLs, sitemap entries and to fetch {SITE_URL}/product.html as the page template.
# Missing = the SEO endpoints answer 503 (the rest of the API is unaffected).
SITE_URL=https://www.example.com

# [optional, default The Gear Doctor] Store name used in page titles ("Product | Store").
STORE_NAME=The Gear Doctor


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# [optional] Port the API listens on (the app binds 0.0.0.0 on this port when set).
# The container image already sets 8080; set it in the Vercel project too so it stays explicit.
# Local dev: leave unset; launchSettings.json / ASPNETCORE_URLS are used.
PORT=8080

# [optional, default Production in the container] Development | Staging | Production.
# Local dev: Development (enables the dev-only JWT key fallback and dev logging).
# Vercel: Production. Never run a public environment as Development.
ASPNETCORE_ENVIRONMENT=Development


# -----------------------------------------------------------------------------
# Tests and tooling (local only)
# -----------------------------------------------------------------------------

# [optional] Postgres used by the integration tests (`dotnet test`).
# If unset, the tests try Testcontainers, which needs Docker.
# Local: a throwaway database (geardoctor_test). CI sets this itself in the workflow.
# TEST_DATABASE_URL=Host=localhost;Database=geardoctor_test;Username=geardoctor;Password=replace-me

# [optional, Development only] Store uploaded product photos on local disk instead of R2,
# so the admin upload flow works without a Cloudflare account. Ignored outside Development.
# DEV_LOCAL_STORAGE=1

