<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GearDoctor.Infrastructure\GearDoctor.Infrastructure.csproj" />
    <ProjectReference Include="..\GearDoctor.Application\GearDoctor.Application.csproj" />
    <ProjectReference Include="..\GearDoctor.Domain\GearDoctor.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GearDoctor.Infrastructure\Seed\catalog.json" Link="seed\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GearDoctor.Infrastructure\Seed\content.json" Link="seed\content.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
